# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=user123
POSTGRES_DB=userdb

# PgAdmin
PGADMIN_EMAIL=admin@genops.com
PGADMIN_PASSWORD=admin

# Auth service — JWT signing keys (RSA-2048, PEM format with \n escaped newlines)
# Leave blank locally: the auth service auto-generates an in-memory key pair at startup.
# Required in production. Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
#   Then escape newlines: awk '{printf "%s\\n", $0}' private.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=auth-key-1

# OpenRouter (OpenAI compatible)
OPENROUTER_API_KEY=sk-or-v1-0... 