# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=user123
POSTGRES_DB=userdb

# PgAdmin
PGADMIN_EMAIL=admin@genops.com
PGADMIN_PASSWORD=admin

# Auth service — JWT signing keys (RSA-2048, PEM format with \n escaped newlines)
# REQUIRED in every environment — auth refuses to start without them (there is
# deliberately no auto-generated fallback: ephemeral keys invalidate all tokens
# on restart and break multi-replica JWKS). Generate once with:
#   ./scripts/gen-jwt-keys.sh >> .env
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=auth-key-1

# Auth service — per-IP register throttle (default 10 per 15-min window; prod-like).
# Raise it (e.g. to 1000) when running the e2e suite against a local stack — the
# suite registers ~20 users from one IP and would hit 429s otherwise.
#AUTH_REGISTER_MAX_ATTEMPTS=10

# Email service — Gmail OAuth2 (from the Google Cloud console > Credentials > OAuth client ID).
# The redirect URI must be registered there exactly and match GOOGLE_REDIRECT_URI below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/api/v1/email/connections/gmail/callback
# Symmetric key used to encrypt stored OAuth tokens at rest (pgcrypto). Use a strong random
# value in production.
EMAIL_TOKEN_ENC_KEY=dev-only-change-me
# HMAC key signing the short-lived OAuth `state` token. Keep it separate from the token
# encryption key so the two can be rotated independently. If unset, docker-compose falls
# back to EMAIL_TOKEN_ENC_KEY.
STATE_SIGNING_KEY=dev-only-change-me
# How often the background poller fetches new emails, in seconds.
EMAIL_POLL_INTERVAL_SECONDS=300

# OpenRouter (OpenAI compatible)
OPENROUTER_API_KEY=sk-or-v1-0...

# Grafana (local `monitoring` compose profile only, http://localhost:3001).
# Login user is `admin`; this sets its password. Defaults to `admin` if unset —
# fine on localhost, never for anything reachable by others.
GRAFANA_ADMIN_PASSWORD=admin

# Langfuse Local Only !!
# genai runs inside Compose, so it reaches Langfuse by its service name — NOT
# localhost (that would be the genai container itself). localhost:3000 is only
# for your browser/UI and the seed_models.py seeder.
LANGFUSE_HOST=http://langfuse-web:3000
# For local self-hosting these can be any matching pair — Langfuse auto-creates a
# project with exactly these keys on first boot. Keep public/secret consistent.
LANGFUSE_PUBLIC_KEY=pk-lf-4...
LANGFUSE_SECRET_KEY=sk-lf-8...
